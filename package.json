{
  "name": "playwright-professional-studies",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and TypeScript QA automation portfolio covering E2E, API, and network testing.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep \"@smoke|@regression\"",
    "test:network": "playwright test --project=network",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
