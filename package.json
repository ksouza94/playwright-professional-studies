{
  "name": "playwright-professional-studies",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratório de estudos profissionais de Playwright e TypeScript para QA Automation.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
